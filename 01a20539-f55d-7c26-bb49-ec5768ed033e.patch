+    } else {
+      this.hasPrevCarrier = true;
+    }
+    this.prevCarrierPos.copy(carrierPos);
+    this.prevCarrierYaw = carrierYaw;
+
+    // 2. Update all corpses
+    for (const b of this.bodies) {
