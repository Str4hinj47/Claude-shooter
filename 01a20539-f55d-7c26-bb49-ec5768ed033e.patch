+
+  const m1 = rbox(0.03, 0.1 * lenScale, 0.058, 0.006, magMat, 0, -0.01, 0, 5);
+  const m2 = rbox(0.03, 0.09 * lenScale, 0.058, 0.006, magMat, 0, -0.095 * lenScale, 0.014, 5);
