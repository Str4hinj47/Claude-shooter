+    setT(this.airflowGain.gain, 0.20 * (0.15 + 0.85 * this.spool) * this.spool * (0.25 + 0.75 * flow), now, 0.05);
+    setF(this.airflowLP.frequency, 900 + 1300 * this.spool, now, TC, 1400);
