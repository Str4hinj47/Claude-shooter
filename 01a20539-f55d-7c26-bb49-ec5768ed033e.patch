+  if (hsl.h < 0.08 || hsl.h > 0.92) return "brick_red";
+  if (hsl.h < 0.14) return hsl.l > 0.68 ? "stucco_warm" : "brick_tan";
+  if (hsl.h >= 0.45 && hsl.h <= 0.65) return "glass_teal";
+  return "stucco_warm";
