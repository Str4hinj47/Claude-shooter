+  addSolidBox(chunk, x + 8, groundY + h2, z - 20.7, 16, 1.0, 0.6, trimMat, 0, "concrete");
+  addSolidBox(chunk, x + 4.5, groundY + h2, z + 20.7, 23, 1.0, 0.6, trimMat, 0, "concrete");
