+
+class GeoBatcher {
+  private readonly buckets = new Map<THREE.Material, THREE.BufferGeometry[]>();
+
+  add(mat: THREE.Material, geo: THREE.BufferGeometry, lx = 0, ly = 0, lz = 0, rx = 0, ry = 0, rz = 0): void {
+    const boxParams = (geo as THREE.BoxGeometry & { parameters?: { width: number; height: number; depth: number } }).parameters;
+    if (boxParams && typeof boxParams.width === "number" && typeof boxParams.height === "number" && typeof boxParams.depth === "number") {
+      bakeBoxMetricUv(geo, boxParams.width, boxParams.height, boxParams.depth, 1.8, 1.8);
+    }
+    const g = geo.index ? geo.toNonIndexed() : geo;
+    if (geo.index) geo.dispose();
+    if (rx) g.rotateX(rx);
+    if (ry) g.rotateY(ry);
+    if (rz) g.rotateZ(rz);
+    if (lx || ly || lz) g.translate(lx, ly, lz);
+    let list = this.buckets.get(mat);
+    if (!list) {
+      list = [];
+      this.buckets.set(mat, list);
+    }
+    list.push(g);
+  }
+
+  flush(parent: THREE.Object3D, castShadow = true, receiveShadow = true): void {
+    for (const [mat, list] of this.buckets) {
+      if (list.length === 0) continue;
+      const merged = list.length === 1 ? list[0] : mergeGeometries(list, false);
+      if (merged) {
+        const mesh = new THREE.Mesh(merged, mat);
+        mesh.castShadow = castShadow;
+        mesh.receiveShadow = receiveShadow;
+        parent.add(mesh);
+      }
+      if (list.length > 1) {
+        for (const g of list) g.dispose();
+      }
+    }
+    this.buckets.clear();
+  }
+}
+
+function addFramedWindowBatched(
+  batch: GeoBatcher,
+  lx: number,
+  lyMid: number,
+  lz: number,
+  w: number,
+  h: number,
+  facing: "front" | "back" | "left" | "right",
+  shutterMat: THREE.Material,
+  withShutters = true,
+): void {
+  const km = getKitMaterials();
+  const ry = facing === "back" ? Math.PI : facing === "right" ? Math.PI * 0.5 : facing === "left" ? -Math.PI * 0.5 : 0;
+  const place = (ox: number, oy: number, oz: number): [number, number, number] => {
+    const c = Math.cos(ry);
+    const s = Math.sin(ry);
+    return [lx + ox * c + oz * s, lyMid + oy, lz - ox * s + oz * c];
+  };
+
+  // Perimeter projecting casing frame (4 pieces leaving recessed reveal around glass)
+  const ft = 0.11;
+  const [tfx, tfy, tfz] = place(0, h * 0.5 + ft * 0.5, 0.08);
+  batch.add(km.trimWhite, new THREE.BoxGeometry(w + ft * 2.4, ft + 0.04, 0.16), tfx, tfy, tfz, 0, ry, 0);
+  const [lfx, lfy, lfz] = place(-w * 0.5 - ft * 0.5, 0, 0.06);
+  batch.add(km.trimWhite, new THREE.BoxGeometry(ft, h, 0.12), lfx, lfy, lfz, 0, ry, 0);
+  const [rfx, rfy, rfz] = place(w * 0.5 + ft * 0.5, 0, 0.06);
+  batch.add(km.trimWhite, new THREE.BoxGeometry(ft, h, 0.12), rfx, rfy, rfz, 0, ry, 0);
+
+  // Recessed glass pane + inner dark shadow sash
+  const [px, py, pz] = place(0, 0, 0.025);
+  batch.add(km.glassPane, new THREE.BoxGeometry(w, h, 0.04), px, py, pz, 0, ry, 0);
+
+  // Inner cross muntins proud of glass but recessed inside outer casing
+  const [mx, my, mz] = place(0, 0, 0.06);
+  batch.add(km.trimWhite, new THREE.BoxGeometry(0.05, h, 0.05), mx, my, mz, 0, ry, 0);
+  batch.add(km.trimWhite, new THREE.BoxGeometry(w, 0.05, 0.05), mx, my + h * 0.08, mz, 0, ry, 0);
+
+  // Projecting stone sill + header drip cap
+  const [sx, sy, sz] = place(0, -h * 0.5 - 0.06, 0.08);
+  batch.add(km.stoneBase, new THREE.BoxGeometry(w + 0.34, 0.1, 0.22), sx, sy, sz, 0, ry, 0);
+
+  if (withShutters) {
+    for (const side of [-1, 1]) {
+      const shW = w * 0.34;
+      const [shx, shy, shz] = place(side * (w * 0.5 + ft + shW * 0.54), 0, 0.04);
+      batch.add(shutterMat, new THREE.BoxGeometry(shW, h + 0.04, 0.07), shx, shy, shz, 0, ry, 0);
+      // Shutter horizontal louver rail accents
+      for (const ryOff of [-h * 0.25, 0, h * 0.25]) {
+        const [rx, ryP, rz] = place(side * (w * 0.5 + ft + shW * 0.54), ryOff, 0.08);
+        batch.add(km.darkSteel, new THREE.BoxGeometry(shW * 0.82, 0.04, 0.02), rx, ryP, rz, 0, ry, 0);
+      }
+    }
+  }
+}
