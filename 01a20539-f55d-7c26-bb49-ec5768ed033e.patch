+    a.dead = true;
+    a.hp = 0;
+    a.respawnTimer = 18.0;
+    const model = a.model;
+    if (model) {
+      a.root.remove(model);
+    }
+    a.model = null;
+    a.mixer = null;
+    a.actions = null;
+    a.shadowMeshes = undefined;
+    a.root.visible = false;
