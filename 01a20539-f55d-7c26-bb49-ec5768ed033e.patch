+++ b/scripts/build-characters.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# Build all selectable characters from game-forge Rocketbox GLBs.
+# Pipeline per character: merge (bone rename + Idle/Walk/Run) -> optimize
+# (gltf-transform) -> fix-facing (180-degree wrapper). Output goes to
+# public/characters/<id>.glb (+ preview PNG for the menu).
+# Usage: ./scripts/build-characters.sh [game-forge-checkout-dir]
+set -euo pipefail
+GF="${1:-/tmp/game-forge}"
+RB="$GF/assets/models/rocketbox"
+OUT="public/characters"
+mkdir -p "$OUT/previews"
+
+# id | source glb | anims glb | preview png | display name
+CHARACTERS=(
+  "military|military-male-01.glb|anims-male.glb|military-male-01.png|Military"
+  "civilian|male-adult-07.glb|anims-male.glb|male-adult-07.png|Civilian"
+  "police|police-male-01.glb|anims-male.glb|police-male-01.png|Police"
+  "security|security-male-01.glb|anims-male.glb|security-male-01.png|Security"
+  "construction|construction-male-01.glb|anims-male.glb|construction-male-01.png|Construction"
+  "firefighter|fire-male-01.glb|anims-male.glb|fire-male-01.png|Firefighter"
+  "business|business-male-01.glb|anims-male.glb|business-male-01.png|Business"
+  "sports|sports-male-01.glb|anims-male.glb|sports-male-01.png|Sports"
+  "delivery|delivery-male-01.glb|anims-male.glb|delivery-male-01.png|Delivery"
+)
+
+for entry in "${CHARACTERS[@]}"; do
+  IFS='|' read -r id src anims preview name <<< "$entry"
+  echo "==> $name ($id)"
+  python3 scripts/merge-rocketbox.py "$RB/$src" "$RB/$anims" "/tmp/char-merged.glb"
+  npx -y @gltf-transform/cli optimize /tmp/char-merged.glb /tmp/char-opt.glb \
+    --texture-size 2048 --weld true --prune true --compress quantize \
+    --simplify false --palette false --texture-compress auto >/dev/null 2>&1
+  python3 scripts/fix-facing.py /tmp/char-opt.glb "$OUT/$id.glb"
+  cp "$RB/_preview/$preview" "$OUT/previews/$id.png"
+  ls -lh "$OUT/$id.glb" | awk '{print "    ", $9, $5}'
+done
+echo "Done. Characters in $OUT/"
diff --git a/scripts/fix-facing.py b/scripts/fix-facing.py
new file mode 100755
index 0000000..1baacd5
--- /dev/null
+++ b/scripts/fix-facing.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Add a 180-degree Y wrapper node so a +Z-facing model matches the rig's
+-Z-facing convention (SoldierRig.setup applies model.rotation.y = PI).
+Usage: python3 scripts/fix-facing.py <input.glb> <output.glb>
+Run AFTER gltf-transform optimize (which flattens the scene graph)."""
+import json, struct, sys
+
+inp, outp = sys.argv[1], sys.argv[2]
+with open(inp, 'rb') as f:
+    data = f.read()
+struct.unpack('<III', data[:12])
+clen, ct = struct.unpack('<II', data[12:20])
+js = json.loads(data[20:20+clen])
+off = 20 + clen
+blen, bt = struct.unpack('<II', data[off:off+8])
+bin_data = data[off+8:off+8+blen]
+roots = js['scenes'][0]['nodes']
+js['nodes'].append({"name": "Character", "rotation": [0, 1, 0, 0], "children": roots})
+js['scenes'][0]['nodes'] = [len(js['nodes']) - 1]
+j = json.dumps(js, separators=(',', ':')).encode()
+j += b' ' * ((4 - len(j) % 4) % 4)
+b = bin_data + b'\x00' * ((4 - len(bin_data) % 4) % 4)
+total = 12 + 8 + len(j) + 8 + len(b)
+with open(outp, 'wb') as f:
+    f.write(struct.pack('<III', 0x46546C67, 2, total))
+    f.write(struct.pack('<II', len(j), 0x4E4F534A)); f.write(j)
+    f.write(struct.pack('<II', len(b), 0x004E4942)); f.write(b)
+print(f"wrote {outp}")
diff --git a/scripts/merge-rocketbox.py b/scripts/merge-rocketbox.py
new file mode 100755
index 0000000..91b74e6
--- /dev/null
+++ b/scripts/merge-rocketbox.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Merge a Rocketbox character GLB with locomotion clips from an anims GLB.
+
+- Renames Bip01 bones to Mixamo names (mixamorig:*) so SoldierRig works.
+- Copies only Idle/Walk/Run animations (channels remapped by bone name).
+- Sets the root transform (Z-up cm -> Y-up m) like the original soldier.
+
+Usage: python3 scripts/merge-rocketbox.py <character.glb> <anims.glb> <out.glb>
+"""
+import json, struct, copy, sys
+
+CHAR, ANIMS, OUT = sys.argv[1], sys.argv[2], sys.argv[3]
+KEEP = {'idle': 'Idle', 'walk': 'Walk', 'run': 'Run'}
+
+def read_glb(path):
+    with open(path, 'rb') as f:
+        data = f.read()
+    magic, ver, length = struct.unpack('<III', data[:12])
+    assert magic == 0x46546C67, 'not glb'
+    off = 12
+    jlen, jtype = struct.unpack('<II', data[off:off+8]); off += 8
+    js = json.loads(data[off:off+jlen]); off += jlen
+    bin_data = b''
+    if off < len(data):
+        blen, btype = struct.unpack('<II', data[off:off+8]); off += 8
+        bin_data = data[off:off+blen]
+    return js, bin_data
+
+def write_glb(path, js, bin_data):
+    j = json.dumps(js, separators=(',', ':')).encode()
+    j += b' ' * ((4 - len(j) % 4) % 4)
+    b = bin_data + b'\x00' * ((4 - len(bin_data) % 4) % 4)
+    total = 12 + 8 + len(j) + 8 + len(b)
+    with open(path, 'wb') as f:
+        f.write(struct.pack('<III', 0x46546C67, 2, total))
+        f.write(struct.pack('<II', len(j), 0x4E4F534A)); f.write(j)
+        f.write(struct.pack('<II', len(b), 0x004E4942)); f.write(b)
+
+def bip_to_mix(name):
+    if not name or not name.startswith('Bip01') or 'Nub' in name:
+        return name
+    rest = name[5:]
+    for side, pre in (('_L_', 'Left'), ('_R_', 'Right')):
+        if rest.startswith(side + 'Finger'):
+            f = rest[len(side + 'Finger'):]
+            fmap = {'0': 'Thumb', '1': 'Index', '2': 'Middle', '3': 'Ring', '4': 'Pinky'}
+            if f and f[0] in fmap and (f[1:] == '' or f[1:].isdigit()):
+                seg = f[1:]
+                segnum = '' if seg == '' else str(int(seg))
+                return 'mixamorig:' + f'{pre}Hand{fmap[f[0]]}{segnum}'
+    simple = {
+        '_Pelvis': 'Hips', '_Spine': 'Spine', '_Spine1': 'Spine1', '_Spine2': 'Spine2',
+        '_Neck': 'Neck', '_Head': 'Head',
+        '_L_Clavicle': 'LeftShoulder', '_R_Clavicle': 'RightShoulder',
+        '_L_UpperArm': 'LeftArm', '_R_UpperArm': 'RightArm',
+        '_L_Forearm': 'LeftForeArm', '_R_Forearm': 'RightForeArm',
+        '_L_Hand': 'LeftHand', '_R_Hand': 'RightHand',
+        '_L_Thigh': 'LeftUpLeg', '_R_Thigh': 'RightUpLeg',
+        '_L_Calf': 'LeftLeg', '_R_Calf': 'RightLeg',
+        '_L_Foot': 'LeftFoot', '_R_Foot': 'RightFoot',
+        '_L_Toe0': 'LeftToeBase', '_R_Toe0': 'RightToeBase',
+    }
+    return 'mixamorig:' + simple[rest] if rest in simple else name
+
+char, char_bin = read_glb(CHAR)
+anims, anims_bin = read_glb(ANIMS)
+
+for js in (char, anims):
+    for n in js['nodes']:
+        if 'name' in n:
+            n['name'] = bip_to_mix(n['name'])
+
+name2idx = {}
+for i, n in enumerate(char['nodes']):
+    if 'name' in n and n['name'] not in name2idx:
+        name2idx[n['name']] = i
+
+required = ['mixamorig:Hips','mixamorig:Spine','mixamorig:Spine1','mixamorig:Spine2','mixamorig:Neck','mixamorig:Head',
+            'mixamorig:LeftArm','mixamorig:LeftForeArm','mixamorig:LeftHand','mixamorig:RightArm','mixamorig:RightForeArm','mixamorig:RightHand',
+            'mixamorig:LeftUpLeg','mixamorig:LeftLeg','mixamorig:LeftFoot','mixamorig:RightUpLeg','mixamorig:RightLeg','mixamorig:RightFoot']
+missing = [r for r in required if r not in name2idx]
+if missing:
+    print(f"ERROR: missing bones {missing} in {CHAR}"); sys.exit(1)
+
+kept = [a for a in anims.get('animations', []) if a.get('name','').lower() in KEEP]
+if len(kept) != 3:
+    print(f"ERROR: expected 3 anims, found {[a.get('name') for a in kept]}"); sys.exit(1)
+ref_acc = set()
+for a in kept:
+    for s in a['samplers']:
+        ref_acc.add(s['input']); ref_acc.add(s['output'])
+ref_bv = set()
+for ai in ref_acc:
+    bv = anims['accessors'][ai].get('bufferView')
+    if bv is not None:
+        ref_bv.add(bv)
+
+pad = (4 - len(char_bin) % 4) % 4
+merged_bin = char_bin + b'\x00' * pad
+bv_map = {}
+for old in sorted(ref_bv):
+    bv = anims['bufferViews'][old]
+    start = bv.get('byteOffset', 0)
+    nb = copy.deepcopy(bv)
+    nb['byteOffset'] = len(merged_bin)
+    bv_map[old] = len(char['bufferViews'])
+    char['bufferViews'].append(nb)
+    merged_bin += anims_bin[start:start+bv['byteLength']]
+    merged_bin += b'\x00' * ((4 - len(merged_bin) % 4) % 4)
+acc_map = {}
+for old in sorted(ref_acc):
+    na = copy.deepcopy(anims['accessors'][old])
+    if 'bufferView' in na:
+        na['bufferView'] = bv_map[na['bufferView']]
+    acc_map[old] = len(char['accessors'])
+    char['accessors'].append(na)
+char['buffers'][0]['byteLength'] = len(merged_bin)
+
+new_anims = []
+for a in kept:
+    na = copy.deepcopy(a)
+    na['name'] = KEEP[a['name'].lower()]
+    for s in na['samplers']:
+        s['input'] = acc_map[s['input']]
+        s['output'] = acc_map[s['output']]
+    kept_ch = []
+    for ch in na['channels']:
+        node_name = anims['nodes'][ch['target']['node']].get('name')
+        if node_name not in name2idx:
+            continue
+        ch['target']['node'] = name2idx[node_name]
+        kept_ch.append(ch)
+    na['channels'] = kept_ch
+    new_anims.append(na)
+char['animations'] = new_anims
+
+root = char['nodes'][0]
+root['rotation'] = [-0.7071067690849304, 0, 0, 0.7071067690849304]
+root['scale'] = [0.01, 0.01, 0.01]
+
+# Rocketbox GLBs from game-forge have textures exported right-side-up (flipY=false)
+# while TEXCOORD_0 retains bottom-up OpenGL V coordinates. Flip V -> 1 - V so
+# standard glTF loaders render face, suit, boots, and hands accurately.
+merged_ba = bytearray(merged_bin)
+uv_accs = set()
+for m in char.get('meshes', []):
+    for p in m.get('primitives', []):
+        if 'TEXCOORD_0' in p.get('attributes', {}):
+            uv_accs.add(p['attributes']['TEXCOORD_0'])
+for ai in sorted(uv_accs):
+    acc = char['accessors'][ai]
+    if acc.get('componentType') != 5126 or acc.get('type') != 'VEC2':
+        continue
+    bv = char['bufferViews'][acc['bufferView']]
+    stride = bv.get('byteStride', 8)
+    base = bv.get('byteOffset', 0) + acc.get('byteOffset', 0)
+    for i in range(acc['count']):
+        pos = base + i * stride + 4
+        v, = struct.unpack_from('<f', merged_ba, pos)
+        struct.pack_into('<f', merged_ba, pos, 1.0 - v)
+    if 'min' in acc and 'max' in acc and len(acc['min']) >= 2 and len(acc['max']) >= 2:
+        mn, mx = acc['min'][1], acc['max'][1]
+        acc['min'][1], acc['max'][1] = 1.0 - mx, 1.0 - mn
+merged_bin = bytes(merged_ba)
+
+write_glb(OUT, char, merged_bin)
+print(f"wrote {OUT} ({len(merged_bin)} bin bytes, anims: {[a['name'] for a in new_anims]})")
diff --git a/scripts/optimize-models.mjs b/scripts/optimize-models.mjs
new file mode 100644
index 0000000..e6c856e
--- /dev/null
+++ b/scripts/optimize-models.mjs
@@ -0,0 +1,85 @@
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const ROOT = process.cwd();
+const GLTFPACK_BIN = path.resolve(
+  ROOT,
+  process.platform === "win32" ? "node_modules/.bin/gltfpack.cmd" : "node_modules/.bin/gltfpack",
+);
+
+if (!fs.existsSync(GLTFPACK_BIN)) {
+  console.error("gltfpack binary not found at", GLTFPACK_BIN);
+  process.exit(1);
+}
+
+function collectGlbs(dir, out = []) {
+  if (!fs.existsSync(dir)) return out;
+  for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, ent.name);
+    if (ent.isDirectory()) collectGlbs(full, out);
+    else if (ent.name.endsWith(".glb")) out.push(full);
+  }
+  return out;
+}
+
+const files = [
+  ...collectGlbs(path.join(ROOT, "public/models")),
+  ...collectGlbs(path.join(ROOT, "public/characters")),
+];
+
+let optimized = 0;
+let skipped = 0;
+let beforeBytes = 0;
+let afterBytes = 0;
+
+for (const file of files) {
+  const origBuf = fs.readFileSync(file);
+  const magic = origBuf.readUInt32LE(0);
+  const version = origBuf.readUInt32LE(4);
+  if (magic !== 0x46546c67 || version !== 2) {
+    skipped++;
+    continue;
+  }
+  const jlen = origBuf.readUInt32LE(12);
+  const gltf = JSON.parse(origBuf.subarray(20, 20 + jlen).toString("utf8"));
+  const exts = new Set([...(gltf.extensionsUsed ?? []), ...(gltf.extensionsRequired ?? [])]);
+  if (exts.has("EXT_meshopt_compression") || exts.has("KHR_draco_mesh_compression")) {
+    skipped++;
+    continue;
+  }
+
+  const tmp = path.join(os.tmpdir(), `gltfpack_${process.pid}_${optimized}.glb`);
+  try {
+    // -c: meshopt compression + high-precision quantization (-vp 16 -vt 16 -vn 12), -kn/-km/-ke: preserve named nodes, materials, extras
+    execFileSync(GLTFPACK_BIN, ["-i", file, "-o", tmp, "-c", "-vp", "16", "-vt", "16", "-vn", "12", "-kn", "-km", "-ke"], { stdio: "pipe" });
+    const newBuf = fs.readFileSync(tmp);
+    const nMagic = newBuf.readUInt32LE(0);
+    const nVer = newBuf.readUInt32LE(4);
+    if (nMagic !== 0x46546c67 || nVer !== 2) {
+      throw new Error(`Invalid GLB v2 output for ${file}`);
+    }
+    const njlen = newBuf.readUInt32LE(12);
+    const ngltf = JSON.parse(newBuf.subarray(20, 20 + njlen).toString("utf8"));
+    for (const img of ngltf.images ?? []) {
+      if (img.uri) throw new Error(`External image URI emitted for ${file}: ${img.uri}`);
+    }
+    if (newBuf.length < origBuf.length) {
+      fs.writeFileSync(file, newBuf);
+      beforeBytes += origBuf.length;
+      afterBytes += newBuf.length;
+      optimized++;
+    } else {
+      skipped++;
+    }
+  } finally {
+    if (fs.existsSync(tmp)) fs.unlinkSync(tmp);
+  }
+}
+
+const savedMB = ((beforeBytes - afterBytes) / 1048576).toFixed(2);
+const pct = beforeBytes > 0 ? Math.round((1 - afterBytes / beforeBytes) * 100) : 0;
+console.log(
+  `meshoptimizer (gltfpack): optimized ${optimized} GLBs, skipped ${skipped} | ${(beforeBytes / 1048576).toFixed(2)} MB -> ${(afterBytes / 1048576).toFixed(2)} MB (saved ${savedMB} MB / ${pct}%)`,
+);
diff --git a/scripts/upscale-glb-textures.mjs b/scripts/upscale-glb-textures.mjs
new file mode 100644
index 0000000..a972981
--- /dev/null
+++ b/scripts/upscale-glb-textures.mjs
@@ -0,0 +1,252 @@
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const ROOT = process.cwd();
+const HERO_TARGET_DIM = 2048;
+const PROP_TARGET_DIM = 1024;
+
+function collectGlbs(dir, out = []) {
+  if (!fs.existsSync(dir)) return out;
+  for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, ent.name);
+    if (ent.isDirectory()) collectGlbs(full, out);
+    else if (ent.name.endsWith(".glb")) out.push(full);
+  }
+  return out;
+}
+
+function getImageDims(buf, mime) {
+  if (buf.length < 24) return null;
+  if (mime === "image/png" || (buf[0] === 0x89 && buf[1] === 0x50)) {
+    return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20), ext: "png" };
+  }
+  if (mime === "image/jpeg" || (buf[0] === 0xff && buf[1] === 0xd8)) {
+    let off = 2;
+    while (off < buf.length - 8) {
+      const marker = buf.readUInt16BE(off);
+      const len = buf.readUInt16BE(off + 2);
+      if (marker >= 0xffc0 && marker <= 0xffc3) {
+        return { w: buf.readUInt16BE(off + 5), h: buf.readUInt16BE(off + 7), ext: "jpg" };
+      }
+      off += 2 + len;
+    }
+  }
+  if (mime === "image/webp" || (buf.subarray(0, 4).toString("ascii") === "RIFF" && buf.subarray(8, 12).toString("ascii") === "WEBP")) {
+    try {
+      const tmp = path.join(os.tmpdir(), `webp_probe_${process.pid}.webp`);
+      fs.writeFileSync(tmp, buf);
+      const out = execFileSync("identify", ["-format", "%w %h", tmp], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
+      fs.unlinkSync(tmp);
+      const [w, h] = out.split(/\s+/).map(Number);
+      if (w > 0 && h > 0) return { w, h, ext: "webp" };
+    } catch {
+      return null;
+    }
+  }
+  return null;
+}
+
+function isOpaqueImage(tmpPath) {
+  try {
+    const res = execFileSync("identify", ["-format", "%[opaque]", tmpPath], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
+    return res.toLowerCase() === "true";
+  } catch {
+    return false;
+  }
+}
+
+function pad4(buf) {
+  const rem = buf.length & 3;
+  if (rem === 0) return buf;
+  return Buffer.concat([buf, Buffer.alloc(4 - rem, 0)]);
+}
+
+function processGlb(filePath, targetMax) {
+  const orig = fs.readFileSync(filePath);
+  if (orig.readUInt32LE(0) !== 0x46546c67 || orig.readUInt32LE(4) !== 2) {
+    return { status: "skip-not-glb2" };
+  }
+  const jlen = orig.readUInt32LE(12);
+  const gltf = JSON.parse(orig.subarray(20, 20 + jlen).toString("utf8"));
+  const binHeaderOff = 20 + jlen;
+  if (orig.readUInt32LE(binHeaderOff + 4) !== 0x004e4942) {
+    return { status: "skip-no-bin" };
+  }
+  const binLen = orig.readUInt32LE(binHeaderOff);
+  const bin = orig.subarray(binHeaderOff + 8, binHeaderOff + 8 + binLen);
+
+  let samplersTouched = false;
+  if (Array.isArray(gltf.samplers)) {
+    for (const s of gltf.samplers) {
+      if (s.magFilter !== 9729 || s.minFilter !== 9987) {
+        s.magFilter = 9729; // LINEAR
+        s.minFilter = 9987; // LINEAR_MIPMAP_LINEAR
+        samplersTouched = true;
+      }
+    }
+  }
+
+  const images = gltf.images ?? [];
+  const imgBvMap = new Map();
+  for (let i = 0; i < images.length; i++) {
+    const img = images[i];
+    if (img.bufferView != null) {
+      imgBvMap.set(img.bufferView, i);
+    }
+  }
+
+  let upgradedCount = 0;
+  const newBvSlices = [];
+  let cursor = 0;
+
+  for (let bvIdx = 0; bvIdx < (gltf.bufferViews?.length ?? 0); bvIdx++) {
+    const bv = gltf.bufferViews[bvIdx];
+    const meshoptExt = bv.extensions?.EXT_meshopt_compression;
+
+    // Determine exact byte range in the original BIN chunk (buffer 0)
+    if (meshoptExt) {
+      if ((meshoptExt.buffer ?? 0) !== 0) {
+        throw new Error(`Unsupported meshopt buffer index in ${filePath}`);
+      }
+      const mStart = meshoptExt.byteOffset ?? 0;
+      const mSlice = bin.subarray(mStart, mStart + meshoptExt.byteLength);
+      const alignedOffset = (cursor + 3) & ~3;
+      if (alignedOffset > cursor) {
+        newBvSlices.push(Buffer.alloc(alignedOffset - cursor, 0));
+        cursor = alignedOffset;
+      }
+      meshoptExt.byteOffset = cursor;
+      newBvSlices.push(mSlice);
+      cursor += mSlice.length;
+      continue;
+    }
+
+    const start = bv.byteOffset ?? 0;
+    const rawSlice = bin.subarray(start, start + bv.byteLength);
+    let finalSlice = rawSlice;
+
+    if (imgBvMap.has(bvIdx)) {
+      const imgIdx = imgBvMap.get(bvIdx);
+      const img = images[imgIdx];
+      const info = getImageDims(rawSlice, img.mimeType || "");
+      const maxDim = info ? Math.max(info.w, info.h) : 0;
+      const needsResize = info && maxDim < targetMax;
+
+      if (info && needsResize) {
+        const tmpIn = path.join(os.tmpdir(), `glb_up_in_${process.pid}_${imgIdx}.${info.ext}`);
+        let outExt = info.ext;
+        let outMime = img.mimeType || (info.ext === "png" ? "image/png" : info.ext === "jpg" ? "image/jpeg" : "image/webp");
+        let tmpOut = path.join(os.tmpdir(), `glb_up_out_${process.pid}_${imgIdx}.${outExt}`);
+        try {
+          fs.writeFileSync(tmpIn, rawSlice);
+          // Opaque PNGs upscale cleanly into 2048px JPEG without multi-MB RGBA PNG bloat
+          let effectiveTarget = targetMax;
+          if (info.ext === "png") {
+            if (isOpaqueImage(tmpIn)) {
+              outExt = "jpg";
+              outMime = "image/jpeg";
+              tmpOut = path.join(os.tmpdir(), `glb_up_out_${process.pid}_${imgIdx}.jpg`);
+            } else {
+              // Transparent alpha PNGs (e.g. hair/eyelash masks or wheel rims) cap at 1024px/1536px to keep size lean
+              effectiveTarget = Math.min(targetMax, 1024);
+            }
+          }
+          const scale = effectiveTarget / maxDim;
+          const newW = Math.max(16, Math.round(info.w * scale));
+          const newH = Math.max(16, Math.round(info.h * scale));
+          if (newW > info.w || newH > info.h) {
+            const args = [
+              tmpIn,
+              "-strip",
+              "-filter",
+              "Lanczos",
+              "-resize",
+              `${newW}x${newH}!`,
+              "-unsharp",
+              "0x0.6+0.42+0.02",
+            ];
+            if (outExt === "jpg") {
+              args.push("-sampling-factor", "4:2:0", "-quality", "86");
+            } else if (outExt === "webp") {
+              args.push("-quality", "85");
+            } else {
+              args.push("-define", "png:compression-level=9");
+            }
+            args.push(tmpOut);
+            execFileSync("convert", args, { stdio: "pipe" });
+            const outBytes = fs.readFileSync(tmpOut);
+            if (outBytes.length > 0) {
+              finalSlice = outBytes;
+              img.mimeType = outMime;
+              upgradedCount++;
+            }
+          }
+        } finally {
+          if (fs.existsSync(tmpIn)) fs.unlinkSync(tmpIn);
+          if (fs.existsSync(tmpOut)) fs.unlinkSync(tmpOut);
+        }
+      }
+    }
+
+    const alignedOffset = (cursor + 3) & ~3;
+    if (alignedOffset > cursor) {
+      newBvSlices.push(Buffer.alloc(alignedOffset - cursor, 0));
+      cursor = alignedOffset;
+    }
+    bv.byteOffset = cursor;
+    bv.byteLength = finalSlice.length;
+    newBvSlices.push(finalSlice);
+    cursor += finalSlice.length;
+  }
+
+  if (upgradedCount === 0 && !samplersTouched) {
+    return { status: "unchanged", upgradedCount: 0 };
+  }
+
+  const newBin = pad4(Buffer.concat(newBvSlices));
+  if (gltf.buffers?.[0]) {
+    gltf.buffers[0].byteLength = newBin.length;
+  }
+
+  const jsonBufRaw = Buffer.from(JSON.stringify(gltf), "utf8");
+  const jsonRem = jsonBufRaw.length & 3;
+  const jsonBuf = jsonRem === 0 ? jsonBufRaw : Buffer.concat([jsonBufRaw, Buffer.alloc(4 - jsonRem, 0x20)]);
+
+  const totalLen = 12 + 8 + jsonBuf.length + 8 + newBin.length;
+  const header = Buffer.alloc(12);
+  header.writeUInt32LE(0x46546c67, 0);
+  header.writeUInt32LE(2, 4);
+  header.writeUInt32LE(totalLen, 8);
+
+  const jsonChunkHdr = Buffer.alloc(8);
+  jsonChunkHdr.writeUInt32LE(jsonBuf.length, 0);
+  jsonChunkHdr.writeUInt32LE(0x4e4f534a, 4);
+
+  const binChunkHdr = Buffer.alloc(8);
+  binChunkHdr.writeUInt32LE(newBin.length, 0);
+  binChunkHdr.writeUInt32LE(0x004e4942, 4);
+
+  const outBuf = Buffer.concat([header, jsonChunkHdr, jsonBuf, binChunkHdr, newBin]);
+  fs.writeFileSync(filePath, outBuf);
+  return {
+    status: "upgraded",
+    upgradedCount,
+    beforeKB: Math.round(orig.length / 1024),
+    afterKB: Math.round(outBuf.length / 1024),
+  };
+}
+
+const charGlbs = collectGlbs(path.join(ROOT, "public/characters"));
+const modelGlbs = collectGlbs(path.join(ROOT, "public/models")).filter((f) => !f.includes(`${path.sep}houses${path.sep}`));
+
+for (const file of [...charGlbs, ...modelGlbs]) {
+  const base = path.basename(file);
+  const isProp = /^(ph_|kk_|int_|traffic_cone|loader_tractor)/.test(base);
+  const targetMax = isProp ? PROP_TARGET_DIM : HERO_TARGET_DIM;
+  const res = processGlb(file, targetMax);
+  if (res.status === "upgraded") {
