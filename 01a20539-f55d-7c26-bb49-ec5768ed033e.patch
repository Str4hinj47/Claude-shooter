+          const wallIdx = Math.floor(r0 * HOUSE_WALL_COLORS.length) % HOUSE_WALL_COLORS.length;
+          const roofIdx = Math.floor(r1 * HOUSE_ROOF_COLORS.length) % HOUSE_ROOF_COLORS.length;
+
+          addDetailedHouse(chunk, {
+            x,
+            yBase: lotY,
+            z,
+            w,
+            d,
+            h,
+            wallMat: houseWallMats[wallIdx],
+            roofMat: houseRoofMats[roofIdx],
+            lawnMat,
+            yaw,
+            seed: Math.floor(r3 * 100),
+            district: district.id,
+            foundationDrop: drop,
+          });
+          addLodBox(chunk, x, lotY, z, w, h + 1.8, d, HOUSE_WALL_COLORS[wallIdx], yaw);
+        } else if (district.id === "east_port") {
+          const h = 7.5 + r2 * 7.5;
+          addHiddenColliderBox(chunk, x, yMin - 0.35, z, w, h + drop, d, yaw, "concrete");
+          if (drop > 0.05) {
+            addVisualBox(chunk.nearGroup, x, yMin - 0.35, z, w + 0.16, drop + 0.1, d + 0.16, plinthMat, yaw);
+          }
+          buildGrammarFacadeShell(chunk.nearGroup, {
+            x,
+            yBase: lotY,
+            z,
+            w,
+            h: Math.max(4.5, h - 0.35),
+            d,
+            yaw,
+            style: "concrete_mod",
+            kindOverride: "louver",
+            storefront: false,
+            maxFloors: 3,
+            maxBays: 5,
+            seed: Math.floor(r0 * 999),
+          });
+          addVisualBox(chunk.nearGroup, x, lotY + Math.max(4.5, h - 0.35), z, w + 0.5, 0.55, d + 0.5, warehouseRoofMat, yaw);
+          addRooftopDetails(chunk.nearGroup, x, lotY + Math.max(4.5, h - 0.35) + 0.55, z, w, d, yaw, { seed: Math.floor(r0 * 50) });
+          addLodBox(chunk, x, yMin, z, w, h, d, 0x7b8087, yaw);
+        } else {
+          // Urban tower / mid-rise apartment / storefront block
+          const styles: FacadeStyle[] =
+            district.id === "downtown"
+              ? ["glass_teal", "glass_navy", "glass_slate", "granite_dark", "limestone", "glass_gold"]
+              : district.id === "west_coast"
+                ? ["stucco_warm", "limestone", "glass_teal", "brick_tan"]
+                : ["brick_red", "brick_tan", "stucco_warm", "limestone", "concrete_mod"];
+          const style = styles[Math.floor((r0 + r1) * 10) % styles.length];
+          const lodColors: Record<FacadeStyle, number> = {
+            glass_teal: 0x3b6778,
+            glass_navy: 0x2b4a69,
+            glass_gold: 0x7a6646,
+            glass_slate: 0x4d5b68,
+            limestone: 0xb0a998,
+            granite_dark: 0x4f555e,
+            brick_red: 0x824034,
+            brick_tan: 0x9e8162,
+            concrete_mod: 0x7b8087,
+            stucco_warm: 0xc2aa8a,
+          };
+          const h =
+            district.id === "downtown"
+              ? 18 + Math.floor(r2 * 44)
+              : district.id === "midtown"
+                ? 11 + Math.floor(r2 * 16)
