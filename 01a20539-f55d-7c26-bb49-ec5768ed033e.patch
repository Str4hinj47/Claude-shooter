+import * as THREE from "three";
+
+export interface ShelterZone {
+  ox: number;
+  oy: number;
+  oz: number;
+  cos: number;
+  sin: number;
+  minLx: number;
+  maxLx: number;
+  minLz: number;
+  maxLz: number;
+  maxY: number;
+}
+
+export class Precipitation {
+  readonly group = new THREE.Group();
+  private rain: THREE.LineSegments;
+  private rainGeo: THREE.BufferGeometry;
+  private rainMat: THREE.LineBasicMaterial;
+  private rainPos: Float32Array;
+  private rainVel: Float32Array;
+  private snow: THREE.Points;
+  private snowGeo: THREE.BufferGeometry;
+  private snowMat: THREE.PointsMaterial;
+  private snowPos: Float32Array;
+  private snowVel: Float32Array;
+  private readonly rainCount = 1600;
+  private readonly snowCount = 4400;
+  private readonly box = { x: 46, y: 22, z: 56 };
+  private shelters: ShelterZone[] = [];
+
+  addShelterZone(
+    ox: number,
+    oy: number,
+    oz: number,
+    yaw: number,
+    minLx: number,
+    maxLx: number,
+    minLz: number,
+    maxLz: number,
+    height = 9.0,
+  ) {
+    this.shelters.push({
+      ox,
+      oy,
+      oz,
+      cos: Math.cos(yaw),
+      sin: Math.sin(yaw),
+      minLx,
+      maxLx,
+      minLz,
+      maxLz,
+      maxY: oy + height,
+    });
+  }
+
+  private isInsideShelter(wx: number, wy: number, wz: number): boolean {
+    for (let i = 0; i < this.shelters.length; i++) {
+      const s = this.shelters[i];
+      if (wy > s.maxY || wy < s.oy - 0.5) continue;
+      const dx = wx - s.ox;
+      const dz = wz - s.oz;
+      if (dx * dx + dz * dz > 1600) continue;
+      const lx = dx * s.cos - dz * s.sin;
+      const lz = dx * s.sin + dz * s.cos;
+      if (lx >= s.minLx && lx <= s.maxLx && lz >= s.minLz && lz <= s.maxLz) return true;
+    }
+    return false;
+  }
+
+  constructor(scene: THREE.Scene) {
+    this.rainGeo = new THREE.BufferGeometry();
+    this.rainPos = new Float32Array(this.rainCount * 6);
+    this.rainVel = new Float32Array(this.rainCount * 3);
+    const rainColor = new Float32Array(this.rainCount * 6);
+    for (let i = 0; i < this.rainCount; i++) {
+      this.respawnRain(i, true);
+      const c = 0.55 + Math.random() * 0.25;
+      rainColor.set([c, c + 0.05, c + 0.12, c * 0.3, c * 0.35, c * 0.4], i * 6);
+    }
+    this.rainGeo.setAttribute("position", new THREE.BufferAttribute(this.rainPos, 3).setUsage(THREE.DynamicDrawUsage));
+    this.rainGeo.setAttribute("color", new THREE.BufferAttribute(rainColor, 3));
+    this.rainMat = new THREE.LineBasicMaterial({
+      vertexColors: true,
+      transparent: true,
+      opacity: 0,
+      blending: THREE.AdditiveBlending,
+      depthWrite: false,
+    });
+    this.rain = new THREE.LineSegments(this.rainGeo, this.rainMat);
+    this.rain.frustumCulled = false;
+    this.group.add(this.rain);
+
+    this.snowGeo = new THREE.BufferGeometry();
+    this.snowPos = new Float32Array(this.snowCount * 3);
+    this.snowVel = new Float32Array(this.snowCount * 3);
+    for (let i = 0; i < this.snowCount; i++) this.respawnSnow(i, true);
+    this.snowGeo.setAttribute("position", new THREE.BufferAttribute(this.snowPos, 3).setUsage(THREE.DynamicDrawUsage));
+    const canvas = document.createElement("canvas");
+    canvas.width = canvas.height = 16;
+    const ctx = canvas.getContext("2d")!;
+    const g = ctx.createRadialGradient(8, 8, 0, 8, 8, 8);
+    g.addColorStop(0, "rgba(255,255,255,1)");
+    g.addColorStop(0.5, "rgba(255,255,255,0.7)");
+    g.addColorStop(1, "rgba(255,255,255,0)");
+    ctx.fillStyle = g;
+    ctx.fillRect(0, 0, 16, 16);
+    this.snowMat = new THREE.PointsMaterial({
+      map: new THREE.CanvasTexture(canvas),
+      color: 0xffffff,
+      size: 0.36,
+      transparent: true,
+      opacity: 0,
+      depthWrite: false,
+      sizeAttenuation: true,
+    });
+    this.snow = new THREE.Points(this.snowGeo, this.snowMat);
+    this.snow.frustumCulled = false;
+    this.group.add(this.snow);
+    scene.add(this.group);
+  }
+
+  private respawnRain(i: number, randomY = false) {
+    const i3 = i * 3;
+    const i6 = i * 6;
+    const x = (Math.random() - 0.5) * this.box.x;
+    const y = randomY ? Math.random() * this.box.y - 6 : this.box.y - 6 + Math.random() * 6;
+    const z = (Math.random() - 0.5) * this.box.z;
+    this.rainPos[i6] = x;
+    this.rainPos[i6 + 1] = y;
+    this.rainPos[i6 + 2] = z;
+    this.rainVel[i3] = (Math.random() - 0.5) * 0.6;
+    this.rainVel[i3 + 1] = -18 - Math.random() * 10;
+    this.rainVel[i3 + 2] = (Math.random() - 0.5) * 0.6;
+  }
+
+  private respawnSnow(i: number, randomY = false) {
+    const i3 = i * 3;
+    this.snowPos[i3] = (Math.random() - 0.5) * this.box.x;
+    this.snowPos[i3 + 1] = randomY ? Math.random() * this.box.y - 10 : this.box.y - 10 + Math.random() * 5;
+    this.snowPos[i3 + 2] = (Math.random() - 0.5) * this.box.z;
+    this.snowVel[i3] = (Math.random() - 0.5) * 0.6;
+    this.snowVel[i3 + 1] = -1.2 - Math.random() * 1.4;
+    this.snowVel[i3 + 2] = (Math.random() - 0.5) * 0.6;
+  }
+
+  update(
+    dt: number,
+    cameraPos: THREE.Vector3,
+    speed: number,
+    weather: { rain: number; snow: number; wind: number },
+    elapsed: number,
+  ) {
+    this.group.position.copy(cameraPos);
+    this.group.position.y -= 2;
+    const rain = weather.rain;
+    const snow = weather.snow;
+    this.rain.visible = rain > 0.01;
+    this.snow.visible = snow > 0.01;
+    this.rainMat.opacity = rain * 0.85;
+    this.snowMat.opacity = snow * 0.96;
+    const wind = weather.wind * 2.5;
+    const forward = speed * 0.35;
+
+    const gx = this.group.position.x;
+    const gy = this.group.position.y;
+    const gz = this.group.position.z;
+    const hasShelter = this.shelters.length > 0;
+
+    if (this.rain.visible) {
+      const count = Math.floor(this.rainCount * Math.max(0.05, rain));
+      this.rainGeo.setDrawRange(0, count * 2);
+      for (let i = 0; i < count; i++) {
+        const i3 = i * 3;
+        const i6 = i * 6;
+        let x = this.rainPos[i6] + (this.rainVel[i3] + wind) * dt;
+        let y = this.rainPos[i6 + 1] + this.rainVel[i3 + 1] * dt;
+        let z = this.rainPos[i6 + 2] + (this.rainVel[i3 + 2] + forward) * dt;
+        if (y < -8 || z > this.box.z / 2 || z < -this.box.z / 2) {
+          this.respawnRain(i);
+          x = this.rainPos[i6];
+          y = this.rainPos[i6 + 1];
+          z = this.rainPos[i6 + 2];
+        }
+        const len = 0.55 + Math.min(0.8, Math.abs(speed) * 0.012);
+        const vy = this.rainVel[i3 + 1];
+        const vz = this.rainVel[i3 + 2] + forward;
+        const mag = Math.hypot(vy, vz) || 1;
+        this.rainPos[i6] = x;
+        this.rainPos[i6 + 1] = y;
+        this.rainPos[i6 + 2] = z;
+        if (hasShelter && this.isInsideShelter(gx + x, gy + y, gz + z)) {
+          this.rainPos[i6 + 3] = x;
+          this.rainPos[i6 + 4] = y;
+          this.rainPos[i6 + 5] = z;
+        } else {
+          this.rainPos[i6 + 3] = x - (wind / mag) * len * 0.3;
+          this.rainPos[i6 + 4] = y - (vy / mag) * len;
+          this.rainPos[i6 + 5] = z - (vz / mag) * len;
+        }
+      }
+      this.rainGeo.attributes.position.needsUpdate = true;
+    }
+
+    if (this.snow.visible) {
+      const count = Math.floor(this.snowCount * Math.max(0.05, snow));
+      this.snowGeo.setDrawRange(0, count);
+      for (let i = 0; i < count; i++) {
+        const i3 = i * 3;
+        const sway = Math.sin(elapsed * 0.9 + this.snowPos[i3 + 2] * 0.12) * 0.7;
+        let x = this.snowPos[i3] + (this.snowVel[i3] + wind * 0.5 + sway) * dt;
+        let y = this.snowPos[i3 + 1] + this.snowVel[i3 + 1] * dt;
+        let z = this.snowPos[i3 + 2] + (this.snowVel[i3 + 2] + forward * 0.4) * dt;
+        if (z > this.box.z / 2) z -= this.box.z;
+        if (z < -this.box.z / 2) z += this.box.z;
+        if (x > this.box.x / 2) x -= this.box.x;
+        if (x < -this.box.x / 2) x += this.box.x;
+        if (y < -10) y = this.box.y - 10 + Math.random() * 5;
+        if (hasShelter && this.isInsideShelter(gx + x, gy + y, gz + z)) {
+          // Keep logical flake outside covered building footprint or parked above roof
+          y = this.box.y - 4 + Math.random() * 4;
+        }
+        this.snowPos[i3] = x;
+        this.snowPos[i3 + 1] = y;
+        this.snowPos[i3 + 2] = z;
+      }
+      this.snowGeo.attributes.position.needsUpdate = true;
+    }
+  }
+
+  dispose() {
+    this.rainGeo.dispose();
+    this.rainMat.dispose();
+    this.snowGeo.dispose();
+    this.snowMat.dispose();
+    this.group.removeFromParent();
+  }
+}
diff --git a/src/game/vehicles/RoadSpray.ts b/src/game/vehicles/RoadSpray.ts
new file mode 100644
index 0000000..234bc45
--- /dev/null
+++ b/src/game/vehicles/RoadSpray.ts
@@ -0,0 +1,302 @@
+import * as THREE from "three";
+
+export type TireSurfaceKind = "asphalt" | "dirt" | "grass" | "sand" | "mud" | "rock";
+
+export class RoadSpray {
+  readonly points: THREE.Points;
+  private readonly count = 1024;
+  private positions = new Float32Array(this.count * 3);
+  private colors = new Float32Array(this.count * 3);
+  private sizes = new Float32Array(this.count);
+  private opacity = new Float32Array(this.count);
+  private kinds = new Float32Array(this.count);
+  private seeds = new Float32Array(this.count);
+  private velocities = new Float32Array(this.count * 3);
+  private ages = new Float32Array(this.count).fill(-1);
+  private lives = new Float32Array(this.count);
+  private strengths = new Float32Array(this.count);
+  private initialSizes = new Float32Array(this.count);
+  private ground = new Float32Array(this.count);
+  private geometry = new THREE.BufferGeometry();
+  private material: THREE.PointsMaterial;
+  private posAttr: THREE.BufferAttribute;
+  private colAttr: THREE.BufferAttribute;
+  private sizeAttr: THREE.BufferAttribute;
+  private alphaAttr: THREE.BufferAttribute;
+  private kindAttr: THREE.BufferAttribute;
+  private seedAttr: THREE.BufferAttribute;
+  private hasDirtyClear = false;
+  private cursor = 0;
+  private carry = 0;
+
+  constructor(scene: THREE.Scene) {
+    this.posAttr = new THREE.BufferAttribute(this.positions, 3).setUsage(THREE.DynamicDrawUsage);
+    this.colAttr = new THREE.BufferAttribute(this.colors, 3).setUsage(THREE.DynamicDrawUsage);
+    this.sizeAttr = new THREE.BufferAttribute(this.sizes, 1).setUsage(THREE.DynamicDrawUsage);
+    this.alphaAttr = new THREE.BufferAttribute(this.opacity, 1).setUsage(THREE.DynamicDrawUsage);
+    this.kindAttr = new THREE.BufferAttribute(this.kinds, 1).setUsage(THREE.DynamicDrawUsage);
+    this.seedAttr = new THREE.BufferAttribute(this.seeds, 1).setUsage(THREE.DynamicDrawUsage);
+    this.geometry.setAttribute("position", this.posAttr);
+    this.geometry.setAttribute("color", this.colAttr);
+    this.geometry.setAttribute("spraySize", this.sizeAttr);
+    this.geometry.setAttribute("sprayAlpha", this.alphaAttr);
+    this.geometry.setAttribute("sprayKind", this.kindAttr);
+    this.geometry.setAttribute("spraySeed", this.seedAttr);
+    this.material = new THREE.PointsMaterial({
+      color: 0xffffff,
+      size: 1.0,
+      vertexColors: true,
+      transparent: true,
+      opacity: 0.92,
+      depthWrite: false,
+      sizeAttenuation: true,
+    });
+    this.material.onBeforeCompile = (shader) => {
+      shader.vertexShader = shader.vertexShader
+        .replace(
+          "#include <common>",
+          "#include <common>\nattribute float spraySize; attribute float sprayAlpha; attribute float sprayKind; attribute float spraySeed; varying float vSprayAlpha; varying float vSprayKind; varying float vSpraySeed;",
+        )
+        .replace(
+          "gl_PointSize = size;",
+          "gl_PointSize = size * spraySize; vSprayAlpha = sprayAlpha; vSprayKind = sprayKind; vSpraySeed = spraySeed;",
+        );
+      shader.fragmentShader = shader.fragmentShader
+        .replace(
+          "#include <common>",
+          `#include <common>
+        varying float vSprayAlpha; varying float vSprayKind; varying float vSpraySeed;
+        float sprayHash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7))) * 43758.5453); }
+        float sprayNoise(vec2 p) {
+          vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
+          return mix(mix(sprayHash(i),sprayHash(i+vec2(1.,0.)),f.x),
+                     mix(sprayHash(i+vec2(0.,1.)),sprayHash(i+vec2(1.,1.)),f.x),f.y);
+        }`,
+        )
+        .replace(
+          "#include <color_fragment>",
+          `#include <color_fragment>
+          vec2 uv = gl_PointCoord - vec2(0.5);
+          float a = vSpraySeed * 6.283185;
+          uv = mat2(cos(a),-sin(a),sin(a),cos(a)) * uv;
+          float d = length(uv * vec2(1.0, 1.12)) * 2.0;
+          float shape;
+          if (vSprayKind > 1.5) {
+            shape = 1.0 - smoothstep(0.45, 0.96, d);
+          } else {
+            float n = sprayNoise(uv * 5.2 + vec2(vSpraySeed * 19.0));
+            float edge = 1.0 - smoothstep(0.18, 1.0, d);
+            shape = edge * mix(0.62, 1.25, n);
+          }
+          diffuseColor.a *= clamp(shape, 0.0, 1.0) * vSprayAlpha;`,
+        );
+    };
+    this.material.customProgramCacheKey = () => "road-tire-spray-v3";
+    this.points = new THREE.Points(this.geometry, this.material);
+    this.points.name = "tire-spray";
+    this.points.frustumCulled = false;
+    this.points.visible = false;
+    scene.add(this.points);
+  }
+
+  emitForVehicle(
+    dt: number,
+    position: THREE.Vector3,
+    yawPlusZ: number,
+    width: number,
+    length: number,
+    speed: number,
+    wet: number,
+    snow: number,
+    emitScale = 1.0,
+    slipAmount = 0,
+    surfaceKind: TireSurfaceKind = "asphalt",
+  ) {
+    dt = Math.max(0, Math.min(0.05, dt));
+    const wetness = THREE.MathUtils.clamp(wet, 0, 1);
+    const powder = THREE.MathUtils.clamp(snow, 0, 1);
+    const slip = THREE.MathUtils.clamp(slipAmount, 0, 1);
+    const isOffroad = surfaceKind !== "asphalt";
+    const offroadFactor =
+      surfaceKind === "mud"
+        ? 0.95
+        : surfaceKind === "sand"
+          ? 0.90
+          : surfaceKind === "dirt"
+            ? 0.78
+            : surfaceKind === "grass"
+              ? 0.65
+              : surfaceKind === "rock"
+                ? 0.50
+                : 0;
+    const surfaceEmit = Math.max(wetness, powder, offroadFactor);
+    if (surfaceEmit <= 0.02) return;
+
+    const movement = THREE.MathUtils.smoothstep(Math.abs(speed), 1.6, 16.5);
+    const wheelActivity = Math.max(movement, slip * 0.95);
+    const amount = surfaceEmit * wheelActivity;
+    if (amount <= 0.008) return;
+
+    // Forward direction (+Z convention: (sin(yaw), cos(yaw)))
+    const fx = Math.sin(yawPlusZ);
+    const fz = Math.cos(yawPlusZ);
+    const rx = Math.cos(yawPlusZ);
+    const rz = -Math.sin(yawPlusZ);
+    const spdSign = speed >= 0 ? 1 : -1;
+    const rate = THREE.MathUtils.lerp(165, 360, Math.max(powder, offroadFactor)) * (1 + slip * 0.65);
+    this.carry += dt * amount * rate * emitScale;
+
+    while (this.carry >= 1) {
+      this.carry--;
+      const i = this.cursor++ % this.count;
+      const p = i * 3;
+
+      // Choose dominant tire particle mode: snow > mud > sand/dirt/grass > wet spray
+      let mode: "snow" | "wet" | "mud" | "sand" | "dirt" | "grass" = "wet";
+      if (powder > 0.05 && (powder >= offroadFactor * 0.8 || Math.random() < 0.65)) {
+        mode = "snow";
+      } else if (isOffroad && surfaceKind !== "rock") {
+        mode = surfaceKind;
+      } else if (surfaceKind === "rock") {
+        mode = "dirt";
+      } else if (wetness > 0.04) {
+        mode = "wet";
+      } else {
+        continue;
+      }
+
+      const isGrain =
+        (mode === "snow" && Math.random() < 0.42) ||
+        ((mode === "dirt" || mode === "sand" || mode === "mud" || mode === "grass") && Math.random() < 0.36) ||
+        (mode === "wet" && Math.random() < 0.28);
+      const kind = isGrain ? 2 : mode === "snow" || mode === "dirt" || mode === "sand" || mode === "grass" ? 1 : 0;
+
+      const side = (this.cursor % 2 ? -1 : 1) * width * 0.40;
+      const jitter = (Math.random() - 0.5) * width * 0.14;
+      const isFront = (Math.abs(speed) > 4.5 || slip > 0.35) && (this.cursor % 4 === 0);
+      const axleOffset = (isFront ? length * 0.31 : -length * 0.32) * spdSign;
+      this.positions[p] = position.x + fx * axleOffset + rx * (side + jitter);
+      this.ground[i] = position.y - 0.12;
+      this.positions[p + 1] = position.y + 0.10 + Math.random() * 0.14;
+      this.positions[p + 2] = position.z + fz * axleOffset + rz * (side + jitter);
+
+      const kickBack = Math.max(Math.abs(speed), slip * 11.0) * (mode === "snow" ? 0.34 + Math.random() * 0.24 : 0.40 + Math.random() * 0.22);
+      const backSign = speed >= -0.2 ? -1 : 1;
+      const sideways = (side < 0 ? -1 : 1) * (0.55 + Math.random() * 1.15) * (1 + slip * 0.7);
+      this.velocities[p] = fx * kickBack * backSign + rx * sideways;
+      this.velocities[p + 1] = isGrain
+        ? 1.55 + Math.random() * 2.25 + slip * 0.9
+        : mode === "snow"
+          ? 0.55 + Math.random() * 0.95
+          : 0.48 + Math.random() * 0.85;
+      this.velocities[p + 2] = fz * kickBack * backSign + rz * sideways;
+
+      this.ages[i] = 0;
+      this.lives[i] = isGrain ? 0.52 + Math.random() * 0.38 : 0.68 + Math.random() * 0.58;
+      this.strengths[i] = Math.max(0.35, amount);
+      this.kinds[i] = kind;
+      this.seeds[i] = Math.random();
+      this.initialSizes[i] = isGrain
+        ? 0.11 + Math.random() * 0.08
+        : mode === "snow"
+          ? 0.46 + Math.random() * 0.34
+          : 0.44 + Math.random() * 0.32;
+
+      const shade = 0.88 + Math.random() * 0.12;
+      if (mode === "snow") {
+        this.colors[p] = shade * 0.96;
+        this.colors[p + 1] = shade * 0.98;
+        this.colors[p + 2] = shade;
+      } else if (mode === "sand") {
+        this.colors[p] = shade * 0.86;
+        this.colors[p + 1] = shade * 0.76;
+        this.colors[p + 2] = shade * 0.56;
+      } else if (mode === "mud") {
+        this.colors[p] = shade * 0.34;
+        this.colors[p + 1] = shade * 0.28;
+        this.colors[p + 2] = shade * 0.22;
+      } else if (mode === "grass") {
+        this.colors[p] = shade * 0.46;
+        this.colors[p + 1] = shade * 0.48;
+        this.colors[p + 2] = shade * 0.30;
+      } else if (mode === "dirt") {
+        this.colors[p] = shade * 0.58;
+        this.colors[p + 1] = shade * 0.48;
+        this.colors[p + 2] = shade * 0.36;
+      } else {
+        // wet water mist
+        this.colors[p] = 0.74;
+        this.colors[p + 1] = 0.82;
+        this.colors[p + 2] = 0.90;
+      }
+
+      this.opacity[i] = 0;
+      this.sizes[i] = this.initialSizes[i];
+    }
+  }
+
+  step(dt: number) {
+    dt = Math.max(0, Math.min(0.05, dt));
+    let active = 0;
+    for (let i = 0; i < this.count; i++) {
+      if (this.ages[i] < 0) continue;
+      const age = (this.ages[i] += dt);
+      const life = this.lives[i];
+      const p = i * 3;
+      const kind = this.kinds[i];
+      if (age >= life || this.positions[p + 1] < this.ground[i]) {
+        this.ages[i] = -1;
+        this.opacity[i] = 0;
+        continue;
+      }
+      const t = age / life;
+      if (kind === 2) {
+        this.velocities[p + 1] -= 5.4 * dt;
+      } else if (kind === 1) {
+        this.velocities[p] += Math.sin(age * 6 + this.seeds[i] * 17) * 0.55 * dt;
+        this.velocities[p + 2] += Math.cos(age * 5 + this.seeds[i] * 13) * 0.45 * dt;
+        this.velocities[p + 1] -= 0.35 * dt;
+      }
+      this.positions[p] += this.velocities[p] * dt;
+      this.positions[p + 1] += this.velocities[p + 1] * dt;
+      this.positions[p + 2] += this.velocities[p + 2] * dt;
+      const fade = Math.min(1, t * 9) * Math.pow(1 - t, kind === 2 ? 0.95 : 1.3);
+      this.opacity[i] = fade * this.strengths[i] * (kind === 2 ? 0.94 : kind === 1 ? 0.62 : 0.48);
+      this.sizes[i] = this.initialSizes[i] * (kind === 2 ? 1.0 : kind === 1 ? 1 + t * 2.1 : 1 + t * 2.4);
+      active++;
+    }
+    this.points.visible = active > 0;
+    if (active > 0) {
+      this.posAttr.needsUpdate = true;
+      this.colAttr.needsUpdate = true;
+      this.sizeAttr.needsUpdate = true;
+      this.alphaAttr.needsUpdate = true;
+      this.kindAttr.needsUpdate = true;
+      this.seedAttr.needsUpdate = true;
+      this.hasDirtyClear = true;
+    } else if (this.hasDirtyClear) {
+      this.alphaAttr.needsUpdate = true;
+      this.hasDirtyClear = false;
+    }
+  }
+
+  update(
+    dt: number,
+    position: THREE.Vector3,
+    yawPlusZ: number,
+    width: number,
+    length: number,
+    speed: number,
+    wet: number,
+    snow: number,
+  ) {
+    this.emitForVehicle(dt, position, yawPlusZ, width, length, speed, wet, snow, 1.0);
+    this.step(dt);
+  }
+
+  dispose() {
+    this.geometry.dispose();
+    this.material.dispose();
+    this.points.removeFromParent();
+  }
+}
diff --git a/src/game/vehicles/air/AirVehicleSystem.ts b/src/game/vehicles/air/AirVehicleSystem.ts
new file mode 100644
index 0000000..b6c2c3c
--- /dev/null
+++ b/src/game/vehicles/air/AirVehicleSystem.ts
@@ -0,0 +1,431 @@
+import * as THREE from "three";
+import { clamp, damp, wrapAngle } from "../../../character/math";
+import { fitGlbToDimension, loadCityGlb } from "../../city/PropModels";
+
+export type AirKind = "helicopter" | "airplane";
+
+export interface AirInput {
+  throttle: number; // W/S (+1/-1)
+  roll: number;     // A/D (+1/-1)
+  yaw: number;      // Q/E (+1/-1)
+  climb: number;    // Space (+1) / Shift (-1)
+}
+
+export interface FlyableAircraft {
+  id: string;
+  name: string;
+  kind: AirKind;
+  pos: THREE.Vector3;
+  vel: THREE.Vector3;
+  yaw: number;
+  pitch: number;
+  roll: number;
+  speed: number;
+  throttle: number;
+  rotorPower: number;
+  group: THREE.Group;
+  rotors: THREE.Object3D[];
+  beacon: THREE.Mesh;
+  hp: number;
+  maxHp: number;
+  homePos: THREE.Vector3;
+  homeYaw: number;
+}
+
+/**
+ * MIT-inspired Helicopter (Sketchbook collective/cyclic + gyro stabilization)
+ * and Fixed-Wing Aircraft (open-road wing lift & aerodynamic drag) system.
+ */
+export class AirVehicleSystem {
+  readonly group = new THREE.Group();
+  readonly aircraft: FlyableAircraft[] = [];
+  private readonly airGlbMeta = new Map<FlyableAircraft, { glb: string; kind: AirKind; targetLen: number; beacon: THREE.Mesh; requested?: boolean }>();
+  activeAircraft: FlyableAircraft | null = null;
+  onRotorDownwash?: (pos: THREE.Vector3, overWater: boolean, power: number) => void;
+
+  private animT = 0;
+  private downwashAcc = 0;
+  private readonly groundAt: (x: number, z: number, maxY: number) => number;
+  private readonly terrainAt: (x: number, z: number) => number;
+
+  constructor(
+    terrainAt: (x: number, z: number) => number,
+    groundAt: (x: number, z: number, maxY: number) => number,
+  ) {
+    this.group.name = "westgate-air-vehicles";
+    this.terrainAt = terrainAt;
+    this.groundAt = groundAt;
+    this.spawnFleet();
+  }
+
+  private ensureAircraftModel(ac: FlyableAircraft): void {
+    const meta = this.airGlbMeta.get(ac);
+    if (!meta || meta.requested) return;
+    meta.requested = true;
+    void loadCityGlb(meta.glb).then((scene) => {
+      if (!scene) return;
+      const fitted = fitGlbToDimension(scene, "z", meta.targetLen, 0);
+      const glbRotors: THREE.Object3D[] = [];
+      fitted.traverse((o) => {
+        const n = o.name.toLowerCase();
+        if (meta.kind === "helicopter") {
+          if (n === "empty001" || n === "cube004") glbRotors.push(o);
+          else if (n === "empty" || n === "cube002") {
+            o.userData.isTailRotor = true;
+            glbRotors.push(o);
+          }
+        } else if (n === "prop") {
+          o.userData.isProp = true;
+          glbRotors.push(o);
+        }
+      });
+      ac.group.clear();
+      ac.group.add(fitted, meta.beacon);
+      ac.rotors = glbRotors;
+    });
+  }
+
+  private buildHelicopterMesh(accentHex: number): { group: THREE.Group; rotors: THREE.Object3D[] } {
+    const g = new THREE.Group();
+    const hullMat = new THREE.MeshStandardMaterial({ color: accentHex, roughness: 0.3, metalness: 0.6 });
+    const darkMat = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.65, metalness: 0.45 });
+    const glassMat = new THREE.MeshStandardMaterial({
+      color: 0x0f172a,
+      roughness: 0.08,
+      metalness: 0.88,
+      transparent: true,
+      opacity: 0.72,
+    });
+    const bladeMat = new THREE.MeshStandardMaterial({ color: 0x27272a, roughness: 0.4, metalness: 0.5 });
+
+    const fuselage = new THREE.Mesh(new THREE.BoxGeometry(1.75, 1.45, 4.2), hullMat);
+    fuselage.position.set(0, 1.35, 0.2);
+    fuselage.castShadow = true;
+    const nose = new THREE.Mesh(new THREE.BoxGeometry(1.58, 1.15, 1.35), glassMat);
+    nose.position.set(0, 1.45, 2.35);
+    const tailBoom = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.44, 4.4), hullMat);
+    tailBoom.position.set(0, 1.55, -3.5);
+    tailBoom.castShadow = true;
+    const fin = new THREE.Mesh(new THREE.BoxGeometry(0.14, 1.15, 0.72), hullMat);
+    fin.position.set(0, 2.0, -5.45);
+
+    // Landing skids
+    for (const sx of [-0.92, 0.92]) {
+      const skid = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.1, 3.8), darkMat);
+      skid.position.set(sx, 0.08, 0.25);
+      const strutF = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.7, 6), darkMat);
+      strutF.position.set(sx, 0.38, 1.1);
+      const strutR = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.7, 6), darkMat);
+      strutR.position.set(sx, 0.38, -0.75);
+      g.add(skid, strutF, strutR);
+    }
+
+    // Main rotor mast + 4 blades
+    const mainRotor = new THREE.Group();
+    mainRotor.position.set(0, 2.35, 0.1);
+    const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.14, 0.45, 10), darkMat);
+    mast.position.y = -0.15;
+    mainRotor.add(mast);
+    for (let i = 0; i < 4; i++) {
+      const blade = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.04, 4.6), bladeMat);
+      blade.rotation.y = (i * Math.PI) / 2;
+      blade.position.set(Math.sin(blade.rotation.y) * 2.3, 0.05, Math.cos(blade.rotation.y) * 2.3);
+      mainRotor.add(blade);
+    }
+
+    // Tail rotor
+    const tailRotor = new THREE.Group();
+    tailRotor.position.set(0.2, 2.05, -5.45);
+    const tb1 = new THREE.Mesh(new THREE.BoxGeometry(0.05, 1.25, 0.14), bladeMat);
+    const tb2 = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.14, 1.25), bladeMat);
+    tailRotor.add(tb1, tb2);
+    tailRotor.userData.isTailRotor = true;
+
+    g.add(fuselage, nose, tailBoom, fin, mainRotor, tailRotor);
+    return { group: g, rotors: [mainRotor, tailRotor] };
+  }
+
+  private buildAirplaneMesh(accentHex: number): { group: THREE.Group; rotors: THREE.Object3D[] } {
+    const g = new THREE.Group();
+    const hullMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.28, metalness: 0.35 });
+    const stripeMat = new THREE.MeshStandardMaterial({ color: accentHex, roughness: 0.32, metalness: 0.45 });
+    const glassMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.08, metalness: 0.85 });
+    const darkMat = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.7, metalness: 0.4 });
+
+    const body = new THREE.Mesh(new THREE.BoxGeometry(1.25, 1.15, 5.6), hullMat);
+    body.position.set(0, 1.15, 0);
+    body.castShadow = true;
+    const canopy = new THREE.Mesh(new THREE.BoxGeometry(1.08, 0.65, 1.85), glassMat);
+    canopy.position.set(0, 1.72, 0.35);
+    const wing = new THREE.Mesh(new THREE.BoxGeometry(9.6, 0.14, 1.65), stripeMat);
+    wing.position.set(0, 1.05, 0.45);
+    wing.castShadow = true;
+    const tailH = new THREE.Mesh(new THREE.BoxGeometry(3.2, 0.1, 0.95), stripeMat);
+    tailH.position.set(0, 1.25, -2.45);
+    const tailV = new THREE.Mesh(new THREE.BoxGeometry(0.12, 1.35, 1.05), stripeMat);
+    tailV.position.set(0, 1.85, -2.4);
+
+    // Tricycle landing gear
+    for (const [gx, gz] of [[0, 2.05], [-1.35, 0.2], [1.35, 0.2]] as const) {
+      const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.65, 6), darkMat);
+      strut.position.set(gx, 0.55, gz);
+      const wheel = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.24, 0.14, 10), darkMat);
+      wheel.rotation.z = Math.PI * 0.5;
+      wheel.position.set(gx, 0.24, gz);
+      g.add(strut, wheel);
+    }
+
+    const prop = new THREE.Group();
+    prop.position.set(0, 1.18, 2.9);
+    const p1 = new THREE.Mesh(new THREE.BoxGeometry(1.9, 0.16, 0.05), darkMat);
+    const p2 = new THREE.Mesh(new THREE.BoxGeometry(0.16, 1.9, 0.05), darkMat);
+    prop.add(p1, p2);
+    prop.userData.isProp = true;
+
+    g.add(body, canopy, wing, tailH, tailV, prop);
+    return { group: g, rotors: [prop] };
+  }
+
+  private spawnFleet(): void {
+    const spawns: Array<{
+      id: string;
+      name: string;
+      kind: AirKind;
+      glb: string;
+      targetLen: number;
+      x: number;
+      z: number;
+      yawDeg: number;
+      hex: number;
+    }> = [
+      { id: "heli_medical", name: "Westgate Maverick Heli", kind: "helicopter", glb: "heli.glb", targetLen: 6.0, x: -146, z: -206, yawDeg: 180, hex: 0x0ea5e9 },
+      { id: "heli_observatory", name: "Summit Tour Chopper", kind: "helicopter", glb: "heli.glb", targetLen: 6.0, x: -112, z: -956, yawDeg: 160, hex: 0xf59e0b },
+      { id: "plane_airport", name: "Westgate F-16 Jet", kind: "airplane", glb: "jet.glb", targetLen: 12.5, x: -120, z: 960, yawDeg: 90, hex: 0xef4444 },
+      { id: "plane_seaport", name: "Cirrus SR-22 Plane", kind: "airplane", glb: "plane.glb", targetLen: 8.2, x: 595, z: 360, yawDeg: 180, hex: 0x10b981 },
+    ];
+
+    const beaconGeo = new THREE.SphereGeometry(0.16, 8, 6);
+    const beaconMat = new THREE.MeshBasicMaterial({ color: 0xff2b2b });
+
+    for (const sp of spawns) {
+      const ty = this.terrainAt(sp.x, sp.z);
+      const gy = this.groundAt(sp.x, sp.z, ty + 25);
+      const yaw = THREE.MathUtils.degToRad(sp.yawDeg);
+      const mesh = sp.kind === "helicopter" ? this.buildHelicopterMesh(sp.hex) : this.buildAirplaneMesh(sp.hex);
+      const beacon = new THREE.Mesh(beaconGeo, beaconMat);
+      beacon.position.set(0, sp.kind === "helicopter" ? 2.15 : 1.75, sp.kind === "helicopter" ? -1.1 : -2.4);
+      beacon.visible = false;
+      mesh.group.add(beacon);
+      mesh.group.position.set(sp.x, gy, sp.z);
+      mesh.group.rotation.y = yaw;
+      this.group.add(mesh.group);
+
+      const ac: FlyableAircraft = {
+        id: sp.id,
+        name: sp.name,
+        kind: sp.kind,
+        pos: new THREE.Vector3(sp.x, gy, sp.z),
+        vel: new THREE.Vector3(),
+        yaw,
+        pitch: 0,
+        roll: 0,
+        speed: 0,
+        throttle: 0,
+        rotorPower: 0,
+        group: mesh.group,
+        rotors: mesh.rotors,
+        beacon,
+        hp: 160,
+        maxHp: 160,
+        homePos: new THREE.Vector3(sp.x, gy, sp.z),
+        homeYaw: yaw,
+      };
+      this.aircraft.push(ac);
+      this.airGlbMeta.set(ac, { glb: sp.glb, kind: sp.kind, targetLen: sp.targetLen, beacon });
+    }
+  }
+
+  findNearestEnterable(pos: THREE.Vector3, maxDist = 6.5): FlyableAircraft | null {
+    if (this.activeAircraft) return null;
+    let best: FlyableAircraft | null = null;
+    let bestD2 = maxDist * maxDist;
+    for (const a of this.aircraft) {
+      if (Math.abs(a.pos.y - pos.y) > 4.5) continue;
+      const d2 = (a.pos.x - pos.x) ** 2 + (a.pos.z - pos.z) ** 2;
+      if (d2 < bestD2) {
+        bestD2 = d2;
+        best = a;
+      }
+    }
+    return best;
+  }
+
+  enterAircraft(a: FlyableAircraft): void {
+    this.activeAircraft = a;
+  }
+
+  exitAircraft(): { pos: THREE.Vector3; altitudeAboveGround: number } | null {
+    const a = this.activeAircraft;
+    if (!a) return null;
+    this.activeAircraft = null;
+    const lx = Math.cos(a.yaw);
+    const lz = -Math.sin(a.yaw);
+    const ex = new THREE.Vector3(a.pos.x + lx * 2.8, a.pos.y, a.pos.z + lz * 2.8);
+    const gy = this.groundAt(ex.x, ex.z, ex.y + 2);
+    const alt = Math.max(0, ex.y - gy);
+    if (alt < 2.2) ex.y = gy;
+    return { pos: ex, altitudeAboveGround: alt };
+  }
+
+  update(dt: number, input: AirInput, focusPos?: THREE.Vector3): void {
+    const cdt = Math.min(Math.max(dt, 0), 0.05);
+    this.animT += cdt;
+    this.downwashAcc += cdt;
+    const emitDownwash = this.downwashAcc >= 0.09;
+    if (emitDownwash) this.downwashAcc = 0;
+
+    const strobeOn = Math.sin(this.animT * 7.5) > 0.35;
+    for (const a of this.aircraft) {
+      if (focusPos && Math.hypot(a.pos.x - focusPos.x, a.pos.z - focusPos.z) < 340) {
+        this.ensureAircraftModel(a);
+      }
+      const isActive = a === this.activeAircraft;
+      const effIn = isActive ? input : { throttle: 0, roll: 0, yaw: 0, climb: 0 };
+
+      if (a.kind === "helicopter") {
+        this.stepHelicopter(a, cdt, effIn, isActive);
+      } else {
+        this.stepAirplane(a, cdt, effIn, isActive);
+      }
+
+      a.beacon.visible = a.rotorPower > 0.18 && strobeOn;
+
+      // Rotor downwash spray/dust when hovering low over water or terrain
+      if (emitDownwash && a.kind === "helicopter" && a.rotorPower > 0.45 && this.onRotorDownwash) {
+        const ty = this.terrainAt(a.pos.x, a.pos.z);
+        const gy = this.groundAt(a.pos.x, a.pos.z, a.pos.y + 1.5);
+        const surfY = Math.max(0, gy);
+        const alt = a.pos.y - surfY;
+        if (alt >= -0.2 && alt < 13.5) {
+          const power = (1 - alt / 13.5) * a.rotorPower;
+          const overWater = ty < -0.15 && gy < 0.25;
+          this.onRotorDownwash(new THREE.Vector3(a.pos.x, surfY + 0.08, a.pos.z), overWater, power);
+        }
+      }
+
+      // Spin main rotor / tail rotor / propeller
+      for (const r of a.rotors) {
+        if (r.userData.isTailRotor) r.rotation.x += a.rotorPower * cdt * 34;
+        else if (r.userData.isProp) r.rotation.z += a.rotorPower * cdt * 38;
+        else r.rotation.y += a.rotorPower * cdt * 26;
+      }
+
+      a.group.position.copy(a.pos);
+      a.group.rotation.order = "YXZ";
+      a.group.rotation.set(a.pitch, a.yaw, a.roll);
+    }
+  }
+
+  private stepHelicopter(a: FlyableAircraft, dt: number, input: AirInput, active: boolean): void {
+    a.rotorPower = damp(a.rotorPower, active ? 1 : 0, active ? 2.2 : 0.85, dt);
+    const gy = Math.max(2.0, this.groundAt(a.pos.x, a.pos.z, a.pos.y + 2.5));
+    const grounded = a.pos.y <= gy + 0.08;
+
+    // Cyclic pitch/roll + tail rotor yaw
+    const targetPitch = active ? input.throttle * 0.34 : 0;
+    const targetRoll = active ? -input.roll * 0.42 : 0;
+    a.pitch = damp(a.pitch, grounded && input.climb <= 0 ? 0 : targetPitch, 4.5, dt);
+    a.roll = damp(a.roll, grounded && input.climb <= 0 ? 0 : targetRoll, 4.5, dt);
+    if (active) {
+      a.yaw = wrapAngle(a.yaw + (input.yaw * 1.45 + input.roll * 0.65) * dt);
+    }
+
+    // Collective vertical acceleration + hover stabilization
+    const hoverLift = active ? 9.81 * a.rotorPower : 0;
+    const climbAccel = active ? input.climb * 15.5 * a.rotorPower : -9.81;
+    a.vel.y += (hoverLift + climbAccel - 9.81) * dt;
+    if (active && Math.abs(input.climb) < 0.05 && a.rotorPower > 0.75) {
+      a.vel.y = damp(a.vel.y, 0, 3.6, dt);
+    }
+
+    // Cyclic horizontal thrust from tilt
+    const fx = Math.sin(a.yaw);
+    const fz = Math.cos(a.yaw);
+    const rx = Math.cos(a.yaw);
+    const rz = -Math.sin(a.yaw);
+    if (!grounded || input.climb > 0) {
+      const fwdThrust = Math.sin(a.pitch) * 34 * a.rotorPower;
+      const sideThrust = -Math.sin(a.roll) * 28 * a.rotorPower;
+      a.vel.x += (fx * fwdThrust - rx * sideThrust) * dt;
+      a.vel.z += (fz * fwdThrust - rz * sideThrust) * dt;
+    }
+    a.vel.x *= Math.exp(-0.85 * dt);
+    a.vel.z *= Math.exp(-0.85 * dt);
+
+    a.pos.x = clamp(a.pos.x + a.vel.x * dt, -1180, 1180);
+    a.pos.z = clamp(a.pos.z + a.vel.z * dt, -1180, 1180);
+    a.pos.y = clamp(a.pos.y + a.vel.y * dt, gy, 420);
+    if (a.pos.y <= gy + 0.01) {
+      a.pos.y = gy;
+      a.vel.y = Math.max(0, a.vel.y);
+      a.vel.x *= Math.exp(-5 * dt);
+      a.vel.z *= Math.exp(-5 * dt);
+    }
+    a.speed = a.vel.length();
+  }
+
+  private stepAirplane(a: FlyableAircraft, dt: number, input: AirInput, active: boolean): void {
+    if (active) {
+      if (input.throttle > 0.1) a.throttle = clamp(a.throttle + 0.55 * dt, 0, 1);
+      else if (input.throttle < -0.1) a.throttle = clamp(a.throttle - 0.7 * dt, 0, 1);
+    } else {
+      a.throttle = clamp(a.throttle - 0.4 * dt, 0, 1);
+    }
+    a.rotorPower = damp(a.rotorPower, active ? Math.max(0.35, a.throttle) : 0, 3.0, dt);
+
+    const gy = Math.max(2.0, this.groundAt(a.pos.x, a.pos.z, a.pos.y + 2.5));
+    const grounded = a.pos.y <= gy + 0.15;
+
+    // Aerodynamic forward thrust & wing drag
+    const thrust = a.throttle * 34;
+    const drag = 0.009 * a.speed * a.speed + (grounded ? 0.35 : 0.08) * a.speed;
+    a.speed = clamp(a.speed + (thrust - drag) * dt, 0, 68);
+
+    // Control surfaces scale with airspeed
+    const ctrlAuth = clamp(a.speed / 18, 0.1, 1);
+    if (active) {
+      const targetRoll = -input.roll * 0.72 * ctrlAuth;
+      a.roll = grounded ? damp(a.roll, 0, 8, dt) : damp(a.roll, targetRoll, 4.0, dt);
+      const targetPitch = input.climb * 0.48 * ctrlAuth;
+      a.pitch = damp(a.pitch, grounded && input.climb <= 0 ? 0 : targetPitch, 3.8, dt);
+      const bankTurn = -Math.sin(a.roll) * 0.95;
+      a.yaw = wrapAngle(a.yaw + (input.yaw * 0.9 + bankTurn) * ctrlAuth * dt);
+    } else {
+      a.roll = damp(a.roll, 0, 3, dt);
+      a.pitch = damp(a.pitch, 0, 3, dt);
+    }
+
+    // Wing lift counteracts gravity once airspeed > ~18 m/s
+    const liftRatio = clamp((a.speed - 12) / 14, 0, 1.15);
+    const fx = Math.sin(a.yaw) * Math.cos(a.pitch);
+    const fy = Math.sin(a.pitch);
+    const fz = Math.cos(a.yaw) * Math.cos(a.pitch);
+
+    a.vel.x = fx * a.speed;
+    a.vel.z = fz * a.speed;
+    const gravityPull = (1 - liftRatio) * 9.81;
+    a.vel.y = fy * a.speed - gravityPull;
+
+    a.pos.x = clamp(a.pos.x + a.vel.x * dt, -1180, 1180);
+    a.pos.z = clamp(a.pos.z + a.vel.z * dt, -1180, 1180);
+    a.pos.y = clamp(a.pos.y + a.vel.y * dt, gy, 460);
+    if (a.pos.y <= gy + 0.01) {
+      a.pos.y = gy;
+      a.vel.y = Math.max(0, a.vel.y);
+    }
+  }
+
+  getBlips(): Array<{ id: string; name: string; kind: AirKind; x: number; z: number }> {
+    return this.aircraft.map((a) => ({ id: a.id, name: a.name, kind: a.kind, x: a.pos.x, z: a.pos.z }));
+  }
+}
