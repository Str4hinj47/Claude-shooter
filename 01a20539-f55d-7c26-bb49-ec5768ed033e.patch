+export type NpcVoiceCategory =
+  | "greeting"
+  | "ambient"
+  | "car_admire"
+  | "honk"
+  | "near_miss"
+  | "bump"
+  | "hit"
+  | "panic"
+  | "weapon_panic"
+  | "body_witness"
+  | "cop"
+  | "carjack"
+  | "robbery";
+
+export interface SpokenLine {
+  speaker: string;
+  text: string;
+  category: NpcVoiceCategory;
+  at: number;
+}
+
+const VOICE_LINES: Record<NpcVoiceCategory, readonly string[]> = {
