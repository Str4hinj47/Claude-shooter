+    addDoorBox(0, 2.78, 0.45, 2.5, 0.06, 0.14, statusMat); // glowing canopy light bar
+    // Double glazed lobby doors + brass vertical pull handles
+    addDoorBox(-0.56, 0.04, -0.05, 1.06, 2.75, 0.12, doorGlassMat);
