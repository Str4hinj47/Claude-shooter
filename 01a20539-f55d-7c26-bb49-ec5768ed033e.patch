+function getBulletHoleAssets(): { geo: THREE.PlaneGeometry; mat: THREE.MeshStandardMaterial } | null {
+  if (typeof document === "undefined") return null;
+  if (!bulletHoleTex) {
+    const c = document.createElement("canvas");
+    c.width = c.height = 64;
+    const ctx = c.getContext("2d");
+    if (ctx) {
+      ctx.clearRect(0, 0, 64, 64);
+      // Outer subtle powder/scorch ring
+      const halo = ctx.createRadialGradient(32, 32, 6, 32, 32, 30);
+      halo.addColorStop(0, "rgba(18, 20, 24, 0.72)");
+      halo.addColorStop(0.45, "rgba(25, 27, 30, 0.28)");
+      halo.addColorStop(1, "rgba(25, 27, 30, 0)");
+      ctx.fillStyle = halo;
+      ctx.beginPath();
+      ctx.arc(32, 32, 30, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Jagged bare-metal paint-chip rim
+      ctx.fillStyle = "rgba(185, 195, 208, 0.85)";
+      ctx.beginPath();
+      for (let i = 0; i < 14; i++) {
+        const a = (i / 14) * Math.PI * 2;
+        const r = 10 + ((i * 7) % 4) * 1.1;
+        const x = 32 + Math.cos(a) * r;
+        const y = 32 + Math.sin(a) * r;
+        if (i === 0) ctx.moveTo(x, y);
+        else ctx.lineTo(x, y);
+      }
+      ctx.closePath();
+      ctx.fill();
+
+      // Dark penetration hole core
+      const core = ctx.createRadialGradient(32, 32, 1, 32, 32, 8);
+      core.addColorStop(0, "rgba(5, 6, 8, 0.98)");
+      core.addColorStop(0.7, "rgba(12, 14, 18, 0.94)");
+      core.addColorStop(1, "rgba(30, 34, 40, 0.25)");
+      ctx.fillStyle = core;
+      ctx.beginPath();
+      ctx.arc(32, 32, 8, 0, Math.PI * 2);
