+/** Hollywood-style 14m white WESTGATE hillside sign (`x=30..184, z=-892`) */
+function buildWestgateHillSign(chunk: CityChunk, terrainAt: TerrainHeightFn): void {
+  const letters = ["W", "E", "S", "T", "G", "A", "T", "E"];
+  const startX = 36;
+  const stepX = 20;
