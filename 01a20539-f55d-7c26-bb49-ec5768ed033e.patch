+    return;
+  }
+
+  const kenneyScale: Partial<Record<TrafficId, number>> = {
+    van: 1.55,
+    delivery: 1.65,
+    ambulance: 1.68,
+    firetruck: 1.85,
+    garbage_truck: 1.85,
+  };
+  const ks = kenneyScale[id];
+  if (ks) {
+    scene.scale.setScalar(ks);
+    scene.traverse((o) => {
+      const mesh = o as THREE.Mesh;
