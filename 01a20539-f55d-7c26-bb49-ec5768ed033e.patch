+      const mats = this.vehicles[i].group.userData?.paintMaterials as THREE.MeshPhysicalMaterial[] | undefined;
+      if (!mats) continue;
+      for (let m = 0; m < mats.length; m++) {
+        mats[m].clearcoat = clearcoat;
+        mats[m].clearcoatRoughness = clearcoatRoughness;
+      }
+    }
+  }
