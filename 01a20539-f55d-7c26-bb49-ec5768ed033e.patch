+          emitFaceBox("frame", bx - bayW * 0.5 + frameThick * 0.5, fy0 + fh * 0.5, -0.05, frameThick, fh, 0.22);
+          emitFaceBox("frame", bx + bayW * 0.5 - frameThick * 0.5, fy0 + fh * 0.5, -0.05, frameThick, fh, 0.22);
+          emitFaceBox(
