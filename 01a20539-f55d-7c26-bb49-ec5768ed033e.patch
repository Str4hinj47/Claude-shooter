+      if (k === "getImageData") return (_x, _y, w, h) => ({ width: w, height: h, data: new Uint8ClampedArray(w * h * 4) });
+      if (k === "measureText") return () => ({ width: 10 });
+      if (k === "canvas") return { width: 256, height: 256 };
+      return () => {};
