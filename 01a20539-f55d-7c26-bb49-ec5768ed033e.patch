+    } else if (kind === "carjack") {
+      this.heat = Math.max(this.heat + 36, 40);
+    } else if (kind === "assault" || kind === "vehicular") {
+      this.heat = Math.max(this.heat + 48, 74);
+    } else if (kind === "robbery") {
+      this.heat = Math.max(this.heat + 65, 86);
