+        outNormals[vi * 3 + 1] = sy / sLen;
+        outNormals[vi * 3 + 2] = sz / sLen;
+      } else {
+        outNormals[vi * 3] = nbx;
+        outNormals[vi * 3 + 1] = nby;
+        outNormals[vi * 3 + 2] = nbz;
+      }
+    }
+  }
