+      P.get('f0').setTargetAtTime(f0, now, tc);
+      P.get('load').setTargetAtTime(x, now, tc);
+      P.get('amp').setTargetAtTime(ampl, now, tc);
+      P.get('rough').setTargetAtTime(clamp(this.inputs.roughness || 0, 0, 1), now, 0.05);
