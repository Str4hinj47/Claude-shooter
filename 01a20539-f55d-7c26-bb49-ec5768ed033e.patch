+              const gy = groundAt(b.pos.x, b.pos.z, carrierPos.y + 0.5);
+              if (gy > 0.2) fx.bloodDrip(b.pos.x, gy, b.pos.z);
+            }
+          }
+        }
+        continue;
+      }
