+    if (spec.parapetHeight > 0.1) {
+      const ph = spec.parapetHeight;
+      const pt = 0.34;
+      gb.addBox("primary", 0, h + ph * 0.5, d * 0.5 - pt * 0.5, w, ph, pt);
+      gb.addBox("primary", 0, h + ph * 0.5, -d * 0.5 + pt * 0.5, w, ph, pt);
+      gb.addBox("primary", -w * 0.5 + pt * 0.5, h + ph * 0.5, 0, pt, ph, d - pt * 2);
+      gb.addBox("primary", w * 0.5 - pt * 0.5, h + ph * 0.5, 0, pt, ph, d - pt * 2);
