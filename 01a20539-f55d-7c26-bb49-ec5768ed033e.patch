+    v.physState.steerAngle = v.steerAngle;
+    v.physState.accel = 0;
+    v.physState.latAccel = 0;
+    v.physState.slip = 0;
+    v.crashTimer = 0;
+    v.crashVx = 0;
+    v.crashVz = 0;
+    v.yawVel = 0;
+    v.turnCurve = null;
+    v.npcSignal = null;
+    v.npcBraking = false;
