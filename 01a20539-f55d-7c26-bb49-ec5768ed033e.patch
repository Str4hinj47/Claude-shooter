+            b.vel.set(0, 0, 0);
+            b.floatTimer = 0.01;
+            fx?.waterSplash(new THREE.Vector3(b.pos.x, waterSurfaceY + 0.1, b.pos.z), 1.35);
+            sfx?.splash();
+          }
