+      for (let i = 0; i < samples.length; i++) {
+        const p = samples[i];
+        const dx = p.x - pos.x;
+        const dz = p.z - pos.z;
+        const d2 = dx * dx + dz * dz;
+        if (d2 < bestD2) {
+          bestD2 = d2;
+          bestT = i / denom;
+        }
+      }
+      // Refine around bestT
+      const span = 1 / denom;
+      for (let k = -4; k <= 4; k++) {
+        const t = ((bestT + (k / 4) * span) % 1 + 1) % 1;
+        const p = lane.curve.getPointAt(t);
+        const dx = p.x - pos.x;
+        const dz = p.z - pos.z;
+        const d2 = dx * dx + dz * dz;
+        if (d2 < bestD2) {
+          bestD2 = d2;
+          bestT = t;
+        }
+      }
+      return bestT;
+    }
+    for (let i = 0; i < 32; i++) {
+      const t = i / 32;
+      const p = lane.curve.getPointAt(t);
+      const dx = p.x - pos.x;
+      const dz = p.z - pos.z;
+      const d2 = dx * dx + dz * dz;
