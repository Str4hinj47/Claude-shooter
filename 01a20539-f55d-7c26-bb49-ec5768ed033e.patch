+  frondShape.quadraticCurveTo(1.2, 0.56, 2.95, -0.45);
+  frondShape.quadraticCurveTo(2.1, -0.18, 1.2, 0.02);
+  frondShape.lineTo(0, -0.07);
+  frondShape.closePath();
+  const palmFronds: THREE.BufferGeometry[] = [];
