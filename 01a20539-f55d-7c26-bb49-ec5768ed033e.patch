+  const posGroups = new Map<string, number[]>();
+  for (let i = 0; i < vCount; i++) {
+    const k = `${Math.round(pos.getX(i) * 10000)},${Math.round(pos.getY(i) * 10000)},${Math.round(pos.getZ(i) * 10000)}`;
