+          a.state = "flee";
+          a.stateTimer = 7.0;
+          const d = Math.hypot(dx, dz) || 1;
+          a.vx = (dx / d) * 4.5;
+          a.vz = (dz / d) * 4.5;
+          a.targetSpeed = 4.5;
+          a.targetYaw = Math.atan2(a.vx, a.vz);
+          this.voices.speak(a.roleId, "hit", a.voiceSeed, 6, true);
+        }
+        return a;
+      }
+    }
+    return null;
+  }
