+/**
+ * Adds a paved urban concrete/granite block plaza apron + corner planter curbs around Downtown/Midtown buildings
+ * so skyscrapers and midrises sit on authentic paved city blocks rather than bare grass.
+ */
+export function addPavedPlazaApron(
+  parent: THREE.Object3D,
+  x: number,
+  yBase: number,
+  z: number,
+  w: number,
+  d: number,
+  yaw: number,
+  opts?: { topOffset?: number; foundationDrop?: number },
+): void {
+  const km = getKitMaterials();
+  const grp = new THREE.Group();
+  grp.position.set(x, yBase, z);
+  grp.rotation.y = yaw;
+  parent.add(grp);
+
+  const b = new GeoBatcher();
+  const pw = w + 3.6;
+  const pd = d + 3.6;
+  const topY = opts?.topOffset ?? 0.08;
+  const drop = Math.max(0, opts?.foundationDrop ?? 0.32);
+  const slabH = 0.28 + drop;
+  // Main paved concrete plaza slab + slightly darker stone border curb
+  b.add(km.concreteWalk, new THREE.BoxGeometry(pw, slabH, pd), 0, topY - slabH * 0.5, 0);
+  b.add(km.stoneBase, new THREE.BoxGeometry(pw + 0.36, 0.14, 0.3), 0, topY + 0.03, pd * 0.5);
+  b.add(km.stoneBase, new THREE.BoxGeometry(pw + 0.36, 0.14, 0.3), 0, topY + 0.03, -pd * 0.5);
+  b.add(km.stoneBase, new THREE.BoxGeometry(0.3, 0.14, pd), pw * 0.5, topY + 0.03, 0);
+  b.add(km.stoneBase, new THREE.BoxGeometry(0.3, 0.14, pd), -pw * 0.5, topY + 0.03, 0);
+
+  // Corner stone planters with sculpted greenery & warm plaza bollard lamps along street-facing corners
+  for (const sx of [-1, 1]) {
+    for (const sz of [-1, 1]) {
+      const px = sx * (w * 0.5 + 0.95);
+      const pz = sz * (d * 0.5 + 0.95);
+      b.add(km.stoneBase, new THREE.BoxGeometry(1.15, 0.46, 1.15), px, topY + 0.22, pz);
+      b.add(km.shrubMat, new THREE.IcosahedronGeometry(0.48, 1), px, topY + 0.64, pz);
+    }
+    const bx = sx * (w * 0.26);
+    const bz = d * 0.5 + 1.25;
+    b.add(km.darkSteel, new THREE.CylinderGeometry(0.1, 0.12, 0.85, 8), bx, topY + 0.42, bz);
+    b.add(km.warmGlow, new THREE.CylinderGeometry(0.09, 0.09, 0.14, 8), bx, topY + 0.88, bz);
+  }
