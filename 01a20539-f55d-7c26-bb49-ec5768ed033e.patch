+export interface BuildFacadeShellOpts {
+  x: number;
+  yBase: number;
+  z: number;
+  w: number;
+  h: number;
+  d: number;
+  yaw?: number;
+  style: FacadeStyle;
+  seed?: number;
+  kindOverride?: FacadeGrammarKind;
+  storefront?: boolean;
+  rhythmOverride?: FacadeRhythm;
+  skipGroundFloor?: boolean;
+  addRoofCap?: boolean;
+  maxFloors?: number;
+  maxBays?: number;
+}
