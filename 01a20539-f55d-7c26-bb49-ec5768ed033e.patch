+      pair.soft.osc.frequency.setTargetAtTime(f0, now, tc);
+      pair.hard.osc.frequency.setTargetAtTime(f0, now, tc);
+      pair.soft.gain.gain.setTargetAtTime(gSoft, now, tc);
+      pair.hard.gain.gain.setTargetAtTime(gHard, now, tc);
+    }
