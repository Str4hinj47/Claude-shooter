+        this.sfx.takedown();
+        this.hitMarker = 0.28;
+        this.hitKill = true;
+        this.camKick.kick(0.9);
+        this.emitHud();
+        return true;
+      }
+    }
+    const target = this.findTakedownTarget();
+    if (!target) return false;
+    this.rig?.triggerTakedown();
+    this.sfx.takedown();
+    this.hitMarker = 0.28;
+    this.hitKill = true;
+    this.camKick.kick(0.9);
+    target.takeDamage(1000, true);
+    this.emitHud();
+    return true;
+  }
