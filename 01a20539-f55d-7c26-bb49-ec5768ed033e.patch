+export function addLodBox(
+  chunk: CityChunk,
+  x: number,
+  yBase: number,
+  z: number,
+  w: number,
+  h: number,
+  d: number,
+  colorHex: number,
+  ry = 0,
+): void {
+  let mat = lodMatCache.get(colorHex);
+  if (!mat) {
+    mat = new THREE.MeshStandardMaterial({ color: colorHex, roughness: 0.72, metalness: 0.15 });
+    lodMatCache.set(colorHex, mat);
