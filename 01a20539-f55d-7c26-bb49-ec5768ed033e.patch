+          // Bob briefly on surface, then sink into the ocean depths
+          b.floatTimer += cdt;
+          if (b.floatTimer > 0.75) {
+            b.sinkDepth += 1.35 * cdt;
+          }
+          const waveBob = Math.sin(b.pos.x * 0.08 + this.time * 2.0) * 0.09;
